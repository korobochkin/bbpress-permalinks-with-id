<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    errorLevel="1"
    resolveFromConfigFile="false"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    phpVersion="8.5"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    checkForThrowsDocblock="true"
    ensureArrayStringOffsetsExist="true"
    cacheDirectory="development/psalm/.cache/psalm-tests-application"
    autoloader="tests/application/vendor/autoload.php"
>
    <projectFiles>
        <directory name="tests/application"/>
        <ignoreFiles>
            <directory name="tests/application/.cache"/>
            <directory name="tests/application/containers"/>
            <directory name="tests/application/vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>
    <ignoreExceptions>
        <classAndDescendants name="PHPUnit\Framework\Exception"/>
    </ignoreExceptions>
</psalm>
